         <pdf:Keywords>Digital twins; Generative artificial intelligence; Multi-modal models; Precision medicine</pdf:Keywords>
         <pdf:Producer>PDFlib+PDI 9.0.7p3 (C++/Win64)</pdf:Producer>
         <dc:format>application/pdf</dc:format>
